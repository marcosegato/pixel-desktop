[Unit]
Description=Google Pixel Floating Auto-Hide Dock (Plank Replacement)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 @PIXEL_DESKTOP_DIR@/pixel_dock.py
Restart=always
RestartSec=2
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=3
Environment=DISPLAY=:0
Environment=GDK_BACKEND=x11

[Install]
WantedBy=graphical-session.target
