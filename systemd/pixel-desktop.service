[Unit]
Description=Google Pixel Desktop UI / Material Design 3 (Widgets & Canvas)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 @PIXEL_DESKTOP_DIR@/pixel_desktop.py
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=3
Environment=DISPLAY=:0
Environment=GDK_BACKEND=x11

[Install]
WantedBy=graphical-session.target
